generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  COLLECTION_STAFF
  BARANGAY_STAFF
  RESIDENT
  GUEST
}

enum WasteType {
  PLASTIC
  PAPER
  GLASS
  METAL
  ELECTRONICS
  ORGANIC
  TEXTILE
  HAZARDOUS
  OTHER
}

enum PickupStatus {
  PENDING
  APPROVED
  COLLECTED
  CANCELLED
  COMPLETED
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum RewardType {
  VOUCHER
  CASH
  GIFT
  DISCOUNT
  BARANGAY_INCENTIVE
}

enum TransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  BONUS
  REFUND
  TRANSFER
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum DirectMessageReactionKind {
  LIKE
  HEART
  FUNNY
  ANGRY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          UserRole  @default(RESIDENT)
  phone         String?
  isActive      Boolean   @default(true)
  lastSeenAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  residentProfile         ResidentProfile?
  staffProfile            StaffProfile?
  notifications           Notification[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  recyclingRecords        RecyclingRecord[]        @relation("RecordedBy")
  verifiedRecycling       RecyclingRecord[]        @relation("VerifiedBy")
  pickupRequests          PickupRequest[]
  assignedPickups         PickupRequest[]          @relation("AssignedStaff")
  redemptionRequests      RedemptionRequest[]
  rewardTransactions      RewardTransaction[]
  userBadges              UserBadge[]
  userAchievements        UserAchievement[]
  aiConversations         AIConversation[]
  passwordResetTokens     PasswordResetToken[]
  smsRecoveryChallenges   SmsRecoveryChallenge[]
  emailVerificationTokens EmailVerificationToken[]
  createdAnnouncements    Announcement[]           @relation("AnnouncementAuthor")
  createdNews             News[]                   @relation("NewsAuthor")
  residentConversations   Conversation[]           @relation("ConversationResident")
  staffConversations      Conversation[]           @relation("ConversationStaff")
  sentMessages            ConversationMessage[]    @relation("MessageSender")
  friendRequestsSent      FriendRequest[]           @relation("FriendRequestSender")
  friendRequestsReceived  FriendRequest[]           @relation("FriendRequestRecipient")
  friendshipsLow          Friendship[]              @relation("FriendshipLow")
  friendshipsHigh         Friendship[]              @relation("FriendshipHigh")
  directConversationsLow  DirectConversation[]      @relation("DirectConversationLow")
  directConversationsHigh DirectConversation[]      @relation("DirectConversationHigh")
  directMessages          DirectMessage[]
  directMessageReactions  DirectMessageReaction[]
  groupMemberships        GroupConversationMember[]
  createdGroupChats       GroupConversation[]    @relation("GroupChatCreator")
  groupMessages           GroupMessage[]
  groupMessageReactions   GroupMessageReaction[]
  sentPointTransfers      PointTransfer[]           @relation("PointTransferSender")
  receivedPointTransfers  PointTransfer[]           @relation("PointTransferRecipient")
  blocksGiven             ResidentBlock[]           @relation("ResidentBlocker")
  blocksReceived          ResidentBlock[]           @relation("ResidentBlocked")

  @@index([role])
  @@index([email])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model SmsRecoveryChallenge {
  id              String    @id @default(cuid())
  userId          String?
  identifierHash  String
  clientHash      String
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  verifiedAt      DateTime?
  resetTokenHash  String?
  resetExpiresAt  DateTime?
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifierHash, createdAt])
  @@index([clientHash, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Barangay {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?   @db.Text
  address     String?
  latitude    Float?
  longitude   Float?
  population  Int?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  residents         ResidentProfile[]
  collectionCenters CollectionCenter[]
  pickupRoutes      PickupRoute[]
  schedules         CollectionSchedule[]

  @@index([code])
  @@index([deletedAt])
}

model ResidentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  barangayId         String?
  qrCode             String   @unique @default(cuid())
  address            String?
  houseNumber        String?
  environmentalScore Int      @default(0)
  recyclingStreak    Int      @default(0)
  totalWeightKg      Float    @default(0)
  carbonSavedKg      Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  barangay         Barangay?         @relation(fields: [barangayId], references: [id], onDelete: SetNull)
  wallet           RewardWallet?
  recyclingRecords RecyclingRecord[]

  @@index([barangayId])
  @@index([qrCode])
}

model StaffProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  employeeId       String?  @unique
  assignedCenterId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCenter CollectionCenter? @relation(fields: [assignedCenterId], references: [id], onDelete: SetNull)
  routes         PickupRoute[]

  @@index([assignedCenterId])
}

model CollectionCenter {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  address     String
  barangayId  String?
  latitude    Float
  longitude   Float
  phone       String?
  openHours   String?
  capacityKg  Float?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  barangay         Barangay?            @relation(fields: [barangayId], references: [id], onDelete: SetNull)
  staff            StaffProfile[]
  recyclingRecords RecyclingRecord[]
  schedules        CollectionSchedule[]
  pickupRoutes     PickupRoute[]

  @@index([barangayId])
  @@index([deletedAt])
}

model WasteCategory {
  id             String    @id @default(cuid())
  type           WasteType @unique
  name           String
  description    String?   @db.Text
  pointsPerKg    Float     @default(1)
  carbonFactorKg Float     @default(0.5)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recyclingRecords RecyclingRecord[]

  @@index([type])
}

model RecyclingRecord {
  id              String    @id @default(cuid())
  residentId      String
  wasteCategoryId String
  centerId        String?
  recordedById    String?
  verifiedById    String?
  weightKg        Float
  quantity        Int       @default(1)
  pointsEarned    Int       @default(0)
  carbonSavedKg   Float     @default(0)
  notes           String?   @db.Text
  images          Json      @default("[]")
  collectionDate  DateTime  @default(now())
  verified        Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  resident      ResidentProfile   @relation(fields: [residentId], references: [userId], onDelete: Cascade)
  wasteCategory WasteCategory     @relation(fields: [wasteCategoryId], references: [id])
  center        CollectionCenter? @relation(fields: [centerId], references: [id], onDelete: SetNull)
  recordedBy    User?             @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  verifiedBy    User?             @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([residentId])
  @@index([collectionDate])
  @@index([wasteCategoryId])
  @@index([deletedAt])
}

model RewardWallet {
  id         String   @id @default(cuid())
  residentId String   @unique
  balance    Int      @default(0)
  lifetime   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resident     ResidentProfile     @relation(fields: [residentId], references: [userId], onDelete: Cascade)
  transactions RewardTransaction[]
}

model RewardTransaction {
  id           String          @id @default(cuid())
  walletId     String
  userId       String
  type         TransactionType
  amount       Int
  balanceAfter Int
  description  String?
  referenceId  String?
  createdAt    DateTime        @default(now())

  wallet RewardWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([createdAt])
}

model Reward {
  id          String     @id @default(cuid())
  name        String
  description String?    @db.Text
  type        RewardType
  pointsCost  Int
  cashValue   Float?
  imageUrl    String?
  stock       Int        @default(0)
  isActive    Boolean    @default(true)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  redemptions RedemptionRequest[]

  @@index([type])
  @@index([deletedAt])
}

model RedemptionRequest {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  points      Int
  status      RedemptionStatus @default(PENDING)
  notes       String?          @db.Text
  fulfilledAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([userId])
  @@index([status])
}

model PickupRequest {
  id              String       @id @default(cuid())
  userId          String
  assignedStaffId String?
  address         String
  latitude        Float?
  longitude       Float?
  scheduledDate   DateTime?
  status          PickupStatus @default(PENDING)
  wasteNotes      String?      @db.Text
  images          Json         @default("[]")
  collectedAt     DateTime?
  deletedAt       DateTime?
  reminderSentAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStaff User?         @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  conversation  Conversation?

  @@index([userId])
  @@index([status])
  @@index([scheduledDate])
}

model Conversation {
  id         String   @id @default(cuid())
  pickupId   String   @unique
  residentId String
  staffId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pickup   PickupRequest         @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  resident User                  @relation("ConversationResident", fields: [residentId], references: [id], onDelete: Cascade)
  staff    User?                 @relation("ConversationStaff", fields: [staffId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]

  @@index([residentId, updatedAt])
  @@index([staffId, updatedAt])
}

model ConversationMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String?   @db.Text
  imageUrl       String?
  imagePublicId  String?
  systemMessage  Boolean   @default(false)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model FriendRequest {
  id          String             @id @default(cuid())
  senderId    String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  sender    User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Friendship {
  id          String   @id @default(cuid())
  userLowId   String
  userHighId  String
  createdAt   DateTime @default(now())

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId, createdAt])
  @@index([userHighId, createdAt])
}

model DirectConversation {
  id                String    @id @default(cuid())
  participantLowId  String
  participantHighId String
  theme             String    @default("forest")
  backgroundImageUrl String?  @db.Text
  lastReadAtLow     DateTime?
  lastReadAtHigh    DateTime?
  hiddenAtLow       DateTime?
  hiddenAtHigh      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  participantLow  User            @relation("DirectConversationLow", fields: [participantLowId], references: [id], onDelete: Cascade)
  participantHigh User            @relation("DirectConversationHigh", fields: [participantHighId], references: [id], onDelete: Cascade)
  messages        DirectMessage[]

  @@unique([participantLowId, participantHighId])
  @@index([participantLowId, updatedAt])
  @@index([participantHighId, updatedAt])
  @@index([participantLowId, hiddenAtLow, updatedAt])
  @@index([participantHighId, hiddenAtHigh, updatedAt])
}

model GroupConversation {
  id             String   @id @default(cuid())
  name           String
  imageUrl       String?  @db.Text
  imagePublicId  String?
  theme          String   @default("forest")
  themeImageUrl  String?  @db.Text
  themeImagePublicId String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User                       @relation("GroupChatCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   GroupConversationMember[]
  messages  GroupMessage[]

  @@index([createdById, updatedAt])
  @@index([updatedAt])
}

model GroupConversationMember {
  id             String    @id @default(cuid())
  groupId        String
  userId         String
  nickname       String?
  isAdmin        Boolean   @default(false)
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  group GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, joinedAt])
}

model GroupMessage {
  id        String    @id @default(cuid())
  groupId   String
  senderId  String
  content   String    @db.Text
  mediaUrl  String?   @db.Text
  mediaType String?
  mediaPublicId String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  group     GroupConversation       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User                    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions GroupMessageReaction[]

  @@index([groupId, createdAt])
  @@index([senderId, createdAt])
}

model GroupMessageReaction {
  id        String                    @id @default(cuid())
  messageId String
  userId    String
  kind      DirectMessageReactionKind
  createdAt DateTime                  @default(now())

  message GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  mediaUrl       String?  @db.Text
  mediaType      String?
  mediaPublicId  String?
  systemMessage  Boolean  @default(false)
  editedAt       DateTime?
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions    DirectMessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model DirectMessageReaction {
  id        String                    @id @default(cuid())
  messageId String
  userId    String
  kind      DirectMessageReactionKind
  createdAt DateTime                  @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model PointTransfer {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  amount      Int
  createdAt   DateTime @default(now())

  sender    User @relation("PointTransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("PointTransferRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model ResidentBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("ResidentBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ResidentBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
}

model PickupRoute {
  id         String   @id @default(cuid())
  name       String
  barangayId String?
  centerId   String?
  staffId    String?
  routeDate  DateTime
  waypoints  Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barangay Barangay?         @relation(fields: [barangayId], references: [id], onDelete: SetNull)
  center   CollectionCenter? @relation(fields: [centerId], references: [id], onDelete: SetNull)
  staff    StaffProfile?     @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([routeDate])
}

model CollectionSchedule {
  id         String    @id @default(cuid())
  title      String
  barangayId String?
  centerId   String?
  startDate  DateTime
  endDate    DateTime?
  recurrence String?
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  barangay Barangay?         @relation(fields: [barangayId], references: [id], onDelete: SetNull)
  center   CollectionCenter? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  @@index([startDate])
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  content   String               @db.Text
  priority  AnnouncementPriority @default(NORMAL)
  authorId  String?
  isPinned  Boolean              @default(false)
  expiresAt DateTime?
  deletedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  author User? @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([deletedAt])
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  imageUrl    String?
  authorId    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([published])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  title     String
  message   String              @db.Text
  type      String              @default("info")
  channel   NotificationChannel @default(IN_APP)
  read      Boolean             @default(false)
  link      String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Badge {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  icon           String?
  criteria       String?
  targetWeightKg Float?
  points         Int      @default(0)
  createdAt      DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  badgeId     String
  bonusPoints Int       @default(0)
  earnedAt    DateTime  @default(now())
  claimedAt   DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  target      Int      @default(1)
  icon        String?
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  completed     Boolean   @default(false)
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Inventory {
  id          String    @id @default(cuid())
  name        String
  sku         String?   @unique
  quantity    Int       @default(0)
  unit        String    @default("pcs")
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String?
  title     String?
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model PlatformStat {
  id              String   @id @default(cuid())
  totalResidents  Int      @default(0)
  totalRecycledKg Float    @default(0)
  totalPoints     Int      @default(0)
  carbonSavedKg   Float    @default(0)
  updatedAt       DateTime @updatedAt
}
