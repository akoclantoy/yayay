# Copy this file to .env.local for local development.
# Never commit .env, .env.local, or real credentials.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Optional direct PostgreSQL URL used by Prisma migrations. Runtime uses DATABASE_URL first.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-secret"
# NEXTAUTH_SECRET is supported as a legacy fallback for AUTH_SECRET.
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Allows demo sign-in locally when DATABASE_URL points to localhost and PostgreSQL is unavailable.
# Never enable this in production.
# MOCK_AUTH="true"
# AUTH_URL and RENDER_EXTERNAL_URL are fallbacks for the application URL.
# AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Gemini AI assistant and waste classification (optional)
# GEMINI_API_KEY=""
# GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
# GEMINI_VISION_MODEL="gemini-2.5-flash"

# Email verification and password reset (optional)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="EcoRewards <noreply@example.com>"

# Cloudinary image uploads (optional)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

Build Command: npm install && npm run build:render
Start Command: npm run start
